#[test]
unconstrained fn kyber768_reference() {
    let (pk, sk) = crate::kyber768::keygen(KYBER768_D, KYBER768_Z);
    assert(pk == KYBER768_PK);
    assert(sk == KYBER768_SK);
    let (ct, key) = crate::kyber768::encapsulate(pk, KYBER768_M);
    assert(ct == KYBER768_CT);
    assert(key == KYBER768_KEY);
    assert(crate::kyber768::decapsulate(sk, ct) == key);
    assert(crate::kyber768::decapsulate(sk, KYBER768_CORRUPT) == KYBER768_FALLBACK);
    assert(crate::kyber768::decapsulate(sk, [0; 1088]) == KYBER768_ZERO_FALLBACK);
}
#[test]
unconstrained fn kyber768_seed_decapsulation() {
    let (pk, key) = crate::kyber768::decapsulate_from_seeds(KYBER768_D, KYBER768_Z, KYBER768_CT);
    assert(pk == KYBER768_PK);
    assert(key == KYBER768_KEY);
    let (pk, key) =
        crate::kyber768::decapsulate_from_seeds(KYBER768_D, KYBER768_Z, KYBER768_CORRUPT);
    assert(pk == KYBER768_PK);
    assert(key == KYBER768_FALLBACK);
    let (pk, key) =
        crate::kyber768::decapsulate_from_seeds(KYBER768_D, KYBER768_OTHER_Z, KYBER768_CORRUPT);
    assert(pk == KYBER768_PK);
    assert(key == KYBER768_OTHER_Z_FALLBACK);
}
#[test(should_fail_with = "recipient key mismatch")]
unconstrained fn kyber768_seed_decapsulation_rejects_other_recipient() {
    // A caller that binds the registered pk rejects another recipient's seeds.
    let (pk, _) =
        crate::kyber768::decapsulate_from_seeds(KYBER768_OTHER_D, KYBER768_Z, KYBER768_CT);
    assert(pk == KYBER768_OTHER_PK);
    assert(pk == KYBER768_PK, "recipient key mismatch");
}
#[test]
unconstrained fn kyber768_alias_key_is_not_the_recipient_key() {
    // Kyber accepts an alias pk; the canonical key holder derives another key.
    let (ct, key) = crate::kyber768::encapsulate(KYBER768_ALIAS_PK, KYBER768_M);
    assert(ct == KYBER768_ALIAS_CT);
    assert(key == KYBER768_ALIAS_KEY);
    assert(crate::kyber768::decapsulate(KYBER768_SK, ct) == KYBER768_ALIAS_RECIPIENT_KEY);
    assert(key != KYBER768_ALIAS_RECIPIENT_KEY);
}
#[test]
fn kyber768_keygen_constrained() {
    let (pk, sk) = crate::kyber768::keygen(
        std::hint::black_box(KYBER768_D),
        std::hint::black_box(KYBER768_Z),
    );
    assert(pk == KYBER768_PK);
    assert(sk == KYBER768_SK);
}
#[test]
fn kyber768_encapsulate_constrained() {
    let (ct, key) = crate::kyber768::encapsulate(
        std::hint::black_box(KYBER768_PK),
        std::hint::black_box(KYBER768_M),
    );
    assert(ct == KYBER768_CT);
    assert(key == KYBER768_KEY);
}
#[test]
fn kyber768_decapsulate_constrained() {
    assert(
        crate::kyber768::decapsulate(
            std::hint::black_box(KYBER768_SK),
            std::hint::black_box(KYBER768_CT),
        )
            == KYBER768_KEY,
    );
}
