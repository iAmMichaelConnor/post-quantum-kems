#[test]
unconstrained fn kyber512_reference() {
    let (pk, sk) = crate::kyber512::keygen(KYBER512_D, KYBER512_Z);
    assert(pk == KYBER512_PK);
    assert(sk == KYBER512_SK);
    let (ct, key) = crate::kyber512::encapsulate(pk, KYBER512_M);
    assert(ct == KYBER512_CT);
    assert(key == KYBER512_KEY);
    assert(crate::kyber512::decapsulate(sk, ct) == key);
    assert(crate::kyber512::decapsulate(sk, KYBER512_CORRUPT) == KYBER512_FALLBACK);
    assert(crate::kyber512::decapsulate(sk, [0; 768]) == KYBER512_ZERO_FALLBACK);
}
#[test]
unconstrained fn kyber512_seed_decapsulation() {
    let (pk, key) = crate::kyber512::decapsulate_from_seeds(KYBER512_D, KYBER512_Z, KYBER512_CT);
    assert(pk == KYBER512_PK);
    assert(key == KYBER512_KEY);
    let (pk, key) =
        crate::kyber512::decapsulate_from_seeds(KYBER512_D, KYBER512_Z, KYBER512_CORRUPT);
    assert(pk == KYBER512_PK);
    assert(key == KYBER512_FALLBACK);
    let (pk, key) =
        crate::kyber512::decapsulate_from_seeds(KYBER512_D, KYBER512_OTHER_Z, KYBER512_CORRUPT);
    assert(pk == KYBER512_PK);
    assert(key == KYBER512_OTHER_Z_FALLBACK);
}
#[test(should_fail_with = "recipient key mismatch")]
unconstrained fn kyber512_seed_decapsulation_rejects_other_recipient() {
    // A caller that binds the registered pk rejects another recipient's seeds.
    let (pk, _) =
        crate::kyber512::decapsulate_from_seeds(KYBER512_OTHER_D, KYBER512_Z, KYBER512_CT);
    assert(pk == KYBER512_OTHER_PK);
    assert(pk == KYBER512_PK, "recipient key mismatch");
}
#[test]
unconstrained fn kyber512_alias_key_is_not_the_recipient_key() {
    // Kyber accepts an alias pk; the canonical key holder derives another key.
    let (ct, key) = crate::kyber512::encapsulate(KYBER512_ALIAS_PK, KYBER512_M);
    assert(ct == KYBER512_ALIAS_CT);
    assert(key == KYBER512_ALIAS_KEY);
    assert(crate::kyber512::decapsulate(KYBER512_SK, ct) == KYBER512_ALIAS_RECIPIENT_KEY);
    assert(key != KYBER512_ALIAS_RECIPIENT_KEY);
}
#[test]
fn kyber512_keygen_constrained() {
    let (pk, sk) = crate::kyber512::keygen(
        std::hint::black_box(KYBER512_D),
        std::hint::black_box(KYBER512_Z),
    );
    assert(pk == KYBER512_PK);
    assert(sk == KYBER512_SK);
}
#[test]
fn kyber512_encapsulate_constrained() {
    let (ct, key) = crate::kyber512::encapsulate(
        std::hint::black_box(KYBER512_PK),
        std::hint::black_box(KYBER512_M),
    );
    assert(ct == KYBER512_CT);
    assert(key == KYBER512_KEY);
}
#[test]
fn kyber512_decapsulate_constrained() {
    assert(
        crate::kyber512::decapsulate(
            std::hint::black_box(KYBER512_SK),
            std::hint::black_box(KYBER512_CT),
        )
            == KYBER512_KEY,
    );
}
