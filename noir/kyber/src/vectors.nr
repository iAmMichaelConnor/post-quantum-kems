global KYBER768_ALIAS_RECIPIENT_KEY: [u8; 32] = [
    88, 122, 254, 193, 0, 66, 239, 225, 156, 129, 160, 138, 142, 55, 190, 252, 228, 80, 40, 40, 0,
    250, 129, 51, 64, 186, 209, 200, 23, 166, 226, 9,
