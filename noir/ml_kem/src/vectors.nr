#[test]
unconstrained fn mlkem768_reference() {
    let (pk, sk) = crate::mlkem768::keygen(MLKEM768_D, MLKEM768_Z);
    assert(pk == MLKEM768_PK);
    assert(sk == MLKEM768_SK);
    let (ct, key) = crate::mlkem768::encapsulate(pk, MLKEM768_M);
    assert(ct == MLKEM768_CT);
    assert(key == MLKEM768_KEY);
    assert(crate::mlkem768::decapsulate(sk, ct) == key);
    assert(crate::mlkem768::decapsulate(sk, MLKEM768_CORRUPT) == MLKEM768_FALLBACK);
    assert(crate::mlkem768::decapsulate(sk, [0; 1088]) == MLKEM768_ZERO_FALLBACK);
}
#[test]
unconstrained fn mlkem768_seed_decapsulation() {
    let (pk, key) = crate::mlkem768::decapsulate_from_seeds(MLKEM768_D, MLKEM768_Z, MLKEM768_CT);
    assert(pk == MLKEM768_PK);
    assert(key == MLKEM768_KEY);
    let (pk, key) =
        crate::mlkem768::decapsulate_from_seeds(MLKEM768_D, MLKEM768_Z, MLKEM768_CORRUPT);
    assert(pk == MLKEM768_PK);
    assert(key == MLKEM768_FALLBACK);
    let (pk, key) =
        crate::mlkem768::decapsulate_from_seeds(MLKEM768_D, MLKEM768_OTHER_Z, MLKEM768_CORRUPT);
    assert(pk == MLKEM768_PK);
    assert(key == MLKEM768_OTHER_Z_FALLBACK);
}
#[test(should_fail_with = "recipient key mismatch")]
unconstrained fn mlkem768_seed_decapsulation_rejects_other_recipient() {
    // A caller that binds the registered pk rejects another recipient's seeds.
    let (pk, _) =
        crate::mlkem768::decapsulate_from_seeds(MLKEM768_OTHER_D, MLKEM768_Z, MLKEM768_CT);
    assert(pk == MLKEM768_OTHER_PK);
    assert(pk == MLKEM768_PK, "recipient key mismatch");
}
#[test]
fn mlkem768_keygen_constrained() {
    let (pk, sk) = crate::mlkem768::keygen(
        std::hint::black_box(MLKEM768_D),
        std::hint::black_box(MLKEM768_Z),
    );
    assert(pk == MLKEM768_PK);
    assert(sk == MLKEM768_SK);
}
#[test]
fn mlkem768_encapsulate_constrained() {
    let (ct, key) = crate::mlkem768::encapsulate(
        std::hint::black_box(MLKEM768_PK),
        std::hint::black_box(MLKEM768_M),
    );
    assert(ct == MLKEM768_CT);
    assert(key == MLKEM768_KEY);
}
#[test]
fn mlkem768_decapsulate_constrained() {
    assert(
        crate::mlkem768::decapsulate(
            std::hint::black_box(MLKEM768_SK),
            std::hint::black_box(MLKEM768_CT),
        )
            == MLKEM768_KEY,
    );
}
