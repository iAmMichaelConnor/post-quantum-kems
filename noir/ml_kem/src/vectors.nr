#[test]
unconstrained fn mlkem512_reference() {
    let (pk, sk) = crate::mlkem512::keygen(MLKEM512_D, MLKEM512_Z);
    assert(pk == MLKEM512_PK);
    assert(sk == MLKEM512_SK);
    let (ct, key) = crate::mlkem512::encapsulate(pk, MLKEM512_M);
    assert(ct == MLKEM512_CT);
    assert(key == MLKEM512_KEY);
    assert(crate::mlkem512::decapsulate(sk, ct) == key);
    assert(crate::mlkem512::decapsulate(sk, MLKEM512_CORRUPT) == MLKEM512_FALLBACK);
    assert(crate::mlkem512::decapsulate(sk, [0; 768]) == MLKEM512_ZERO_FALLBACK);
}
#[test]
unconstrained fn mlkem512_seed_decapsulation() {
    let (pk, key) = crate::mlkem512::decapsulate_from_seeds(MLKEM512_D, MLKEM512_Z, MLKEM512_CT);
    assert(pk == MLKEM512_PK);
    assert(key == MLKEM512_KEY);
    let (pk, key) =
        crate::mlkem512::decapsulate_from_seeds(MLKEM512_D, MLKEM512_Z, MLKEM512_CORRUPT);
    assert(pk == MLKEM512_PK);
    assert(key == MLKEM512_FALLBACK);
    let (pk, key) =
        crate::mlkem512::decapsulate_from_seeds(MLKEM512_D, MLKEM512_OTHER_Z, MLKEM512_CORRUPT);
    assert(pk == MLKEM512_PK);
    assert(key == MLKEM512_OTHER_Z_FALLBACK);
}
#[test(should_fail_with = "recipient key mismatch")]
unconstrained fn mlkem512_seed_decapsulation_rejects_other_recipient() {
    // A caller that binds the registered pk rejects another recipient's seeds.
    let (pk, _) =
        crate::mlkem512::decapsulate_from_seeds(MLKEM512_OTHER_D, MLKEM512_Z, MLKEM512_CT);
    assert(pk == MLKEM512_OTHER_PK);
    assert(pk == MLKEM512_PK, "recipient key mismatch");
}
#[test]
fn mlkem512_keygen_constrained() {
    let (pk, sk) = crate::mlkem512::keygen(
        std::hint::black_box(MLKEM512_D),
        std::hint::black_box(MLKEM512_Z),
    );
    assert(pk == MLKEM512_PK);
    assert(sk == MLKEM512_SK);
}
#[test]
fn mlkem512_encapsulate_constrained() {
    let (ct, key) = crate::mlkem512::encapsulate(
        std::hint::black_box(MLKEM512_PK),
        std::hint::black_box(MLKEM512_M),
    );
    assert(ct == MLKEM512_CT);
    assert(key == MLKEM512_KEY);
}
#[test]
fn mlkem512_decapsulate_constrained() {
    assert(
        crate::mlkem512::decapsulate(
            std::hint::black_box(MLKEM512_SK),
            std::hint::black_box(MLKEM512_CT),
        )
            == MLKEM512_KEY,
    );
}
