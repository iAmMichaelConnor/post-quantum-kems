use crate::{poly, sampling, sponge};

fn arithmetic_cases() {
    let a = std::hint::black_box(3328u32);
    assert(poly::addq(a, a) == 3327);
    assert(poly::subq(0, a) == 1);
    assert(poly::mulq(a, a) == 1);
    let mut p = [0u32; 256];
    p[0] = a;
    p[1] = 1;
    p[255] = a;
    assert(poly::inverse_ntt(poly::ntt(p)) == p);
    let mut x = [0u32; 256];
    x[1] = 1;
    let mut top = [0u32; 256];
    top[255] = 1;
    let product = poly::inverse_ntt(poly::multiply_ntt(poly::ntt(x), poly::ntt(top)));
    let mut expected = [0u32; 256];
    expected[0] = a;
    assert(product == expected); // X^256 = -1, not +1.
    assert(poly::inverse_ntt(poly::ntt([0; 256])) == [0; 256]);
}
#[test]
fn constrained_arithmetic_cases() {
    arithmetic_cases();
}
#[test]
unconstrained fn brillig_arithmetic_cases() {
    arithmetic_cases();
}

fn codec_cases() {
    let mut p = [0u32; 256];
    for i in 0..256 {
        p[i] = (13 * i) % 3329;
    }
    p[255] = std::hint::black_box(3328u32);
    assert(poly::decode::<12>(poly::encode::<12>(p), true) == p);
    assert(poly::compress::<1>([0; 256]) == [0; 256]);
    assert(poly::compress::<1>([832; 256]) == [0; 256]);
    assert(poly::compress::<1>([833; 256]) == [1; 256]);
    assert(poly::compress::<1>([2496; 256]) == [1; 256]);
    assert(poly::compress::<1>([2497; 256]) == [0; 256]);
    assert(poly::decompress::<1>([1; 256]) == [1665; 256]);
    let aliases = poly::encode::<12>([3329; 256]);
    assert(poly::decode::<12>(aliases, false) == [0; 256]);
}
#[test]
fn constrained_codec_cases() {
    codec_cases();
}
#[test]
unconstrained fn brillig_codec_cases() {
    codec_cases();
}
#[test(should_fail_with = "call to assert_max_bit_size")]
fn rejects_modulus_alias() {
    let b = poly::encode::<12>([std::hint::black_box(3329u32); 256]);
    let _ = poly::decode::<12>(b, true);
}

fn sampling_cases() {
    // 152 rejected pairs followed by 128 accepted pairs: final coefficient
    // appears in triplet 280. A shorter implementation would reject this.
    let mut bytes = [255u8; 840];
    for i in 456..840 {
        bytes[i] = 0;
    }
    assert(sampling::parse_ntt(std::hint::black_box(bytes)) == [0; 256]);
    assert(sampling::cbd::<2>([0; 128]) == [0; 256]);
    assert(sampling::cbd::<3>([255; 192]) == [0; 256]);
    assert(sampling::cbd::<2>([51; 128]) == [2; 256]);
    assert(sampling::cbd::<2>([204; 128]) == [3327; 256]);
}
#[test]
fn constrained_sampling_cases() {
    sampling_cases();
}
#[test]
unconstrained fn brillig_sampling_cases() {
    sampling_cases();
}
#[test(should_fail_with = "SampleNTT exhausted")]
fn rejects_exhausted_sampling() {
    let _ = sampling::parse_ntt(std::hint::black_box([255; 840]));
}

