// Independent Python hashlib answers for word-native absorption. These cover
// empty/full/partial rate blocks, zero/max/patterned words and a second squeeze.
#[test]
fn words_sha3_512_0() {
    let input: [u64; 0] = std::hint::black_box([]);
    assert(
        crate::sponge_words::<0, 8, 72, 6>(input)
            == [
                14238757642774486950,
                7959366979270718920,
                6438144496634087831,
                11997690870579909088,
                5546734832493703701,
                6396582807491699473,
                16416665820397633781,
                2795923003559736577,
            ],
    );
}
#[test]
fn words_sha3_512_1() {
    let input: [u64; 1] = std::hint::black_box([0]);
    assert(
        crate::sponge_words::<1, 8, 72, 6>(input)
            == [
                17100877849404759562,
                13645488151964522329,
                5356508994014221081,
                1115463857718319731,
                4147383545458321154,
                7771361381306781142,
                13340713965555659972,
                17796090652684819984,
            ],
    );
}
