// Known answers from Python hashlib; inputs remain witnesses.
#[test]
fn shake128_partial_0() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake128::<3, 0>(input) == []);
}
#[test]
fn shake128_partial_1() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake128::<3, 1>(input) == [108]);
}
#[test]
fn shake128_partial_7() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake128::<3, 7>(input) == [108, 41, 89, 187, 208, 30, 234]);
}
#[test]
fn shake128_partial_8() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake128::<3, 8>(input) == [108, 41, 89, 187, 208, 30, 234, 232]);
}
#[test]
fn shake128_partial_9() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake128::<3, 9>(input) == [108, 41, 89, 187, 208, 30, 234, 232, 245]);
}
#[test]
fn shake128_partial_137() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(
        crate::shake128::<3, 137>(input)
            == [
                108, 41, 89, 187, 208, 30, 234, 232, 245, 60, 104, 100, 193, 169, 127, 123, 160, 51,
                221, 35, 20, 143, 71, 185, 35, 76, 68, 176, 174, 73, 253, 57, 51, 223, 27, 35, 161,
                102, 196, 63, 36, 249, 177, 21, 209, 140, 167, 179, 84, 155, 117, 91, 41, 97, 243,
                54, 245, 68, 97, 252, 88, 219, 74, 247, 2, 177, 63, 86, 45, 248, 155, 81, 192, 188,
                211, 233, 206, 88, 114, 172, 201, 130, 217, 26, 34, 249, 1, 22, 8, 191, 187, 170,
                235, 207, 28, 90, 25, 194, 247, 18, 209, 80, 57, 249, 57, 172, 172, 29, 129, 48,
                189, 52, 78, 252, 236, 95, 50, 179, 14, 70, 86, 231, 242, 51, 48, 146, 37, 132, 56,
                144, 255, 90, 202, 136, 134, 161, 146,
            ],
    );
}
#[test]
fn shake256_partial_0() {
    let input = std::hint::black_box([0u8, 255, 128]);
    assert(crate::shake256::<3, 0>(input) == []);
}
#[test]
