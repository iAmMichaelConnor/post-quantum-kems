    );
}

// Independent hashlib vectors for the direct-lane API, including rate crossing.
#[test]
fn direct_lanes_0_0() {
    assert(crate::sponge_lanes::<0, 0, 168, 31>(std::hint::black_box([255u8; 0])) == []);
}
