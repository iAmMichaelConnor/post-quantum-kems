#[test]
fn sha3_maximum_bytes_135() {
    let input = std::hint::black_box([255u8; 135]);
    assert(
        crate::h(input)
            == [
                239, 238, 85, 23, 22, 248, 8, 37, 122, 90, 226, 50, 81, 71, 26, 76, 93, 244, 125,
                108, 23, 14, 138, 135, 90, 232, 125, 11, 210, 109, 133, 68,
            ],
    );
}
